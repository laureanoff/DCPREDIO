# ============================================================
# DC Predio — variables de entorno
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local a GitHub.
# ============================================================

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SOLO SERVIDOR. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Business Cloud API (Meta) — SOLO SERVIDOR ---
# Se completan en la Fase 7 (ver README, sección WhatsApp).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Número del predio que recibe los avisos, en formato internacional sin "+" (ej: 5493511234567)
WHATSAPP_VENUE_NUMBER=
WHATSAPP_API_VERSION=v21.0
# Nombres de plantillas aprobadas en Meta
WHATSAPP_TEMPLATE_VENUE=
WHATSAPP_TEMPLATE_CUSTOMER=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
# Alternativa gratuita a WhatsApp: avisos por Telegram (ver docs/notificaciones.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
